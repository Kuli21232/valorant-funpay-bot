TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

FUNPAY_GOLDEN_KEY=
FUNPAY_PHPSESSID=
FUNPAY_USER_ID=
FUNPAY_POLL_INTERVAL=15

DATABASE_URL=sqlite+aiosqlite:///./bot.db
AUTO_REPLY_TEXT=Спасибо за заказ! Аккаунт будет выдан в ближайшее время.

# Прокси для Telegram (нужен в РФ из-за блокировок). Оставьте пустым, если не нужно.
# Форматы:
#   http://user:pass@host:port
#   socks5://user:pass@host:port
TELEGRAM_PROXY=

# Прокси для FunPay (обычно не нужен — FunPay в РФ работает напрямую).
FUNPAY_PROXY=

# Прокси для Riot API (КРИТИЧНО для РФ/СНГ).
# Riot блокирует датацентровые IP (VPN, GCP, AWS) — возвращает
# `invalid_request` независимо от логина/пароля. Нужен residential proxy:
# BrightData, Smartproxy, IPRoyal — ~$2-8 за GB трафика.
# Формат: socks5://user:pass@host:port или http://user:pass@host:port
RIOT_PROXY=

# CapSolver — РЕКОМЕНДУЕМЫЙ для Riot (специализирован на hCaptcha Enterprise).
# 80-95% success rate против ~20-40% у 2captcha. Дешевле и надёжнее.
# Регистрация: https://dashboard.capsolver.com, пополнить ~$3-5.
CAPSOLVER_KEY=

# 2captcha — fallback. На Riot enterprise hCaptcha часто не справляется.
TWOCAPTCHA_KEY=

# Ручной override для hCaptcha sitekey Riot — на случай если бот не нашёл
# его автоматически (например, Riot изменил структуру страницы).
# Способ получения: откройте authenticate.riotgames.com в Chrome → F12 →
# Elements → найдите iframe с src содержащим sitekey=<UUID>. Скопируйте UUID.
RIOT_HCAPTCHA_SITEKEY=

# Пропустить headless Playwright grabber rqdata при API-логине.
# Если подозреваете, что лишний запуск Chromium портит сессию / IP reputation,
# установите True. Капча всё равно решится через CAPSOLVER_KEY, просто
# без enterprise rqdata (успешность чуть ниже, но без лишнего браузера).
RIOT_SKIP_RQDATA=False

# Запускать браузер Riot в headless-режиме. False = видно окно (полезно для отладки).
RIOT_HEADLESS=False
RIOT_TIMEOUT_MS=45000

# URL для входа в Riot. По умолчанию используется https://auth.riotgames.com/login
#
# Если этот URL не работает (Riot Account показывает "Oops! Something went wrong"
# или блокирует логин), вставьте свежую ссылку из Valorant клиента:
#   1. Откройте Riot Client / Valorant
#   2. Нажмите "Sign in with QR code" или "Войти через браузер"
#   3. Скопируйте URL из открывшегося окна браузера
#   4. Вставьте его сюда (одной строкой)
# Эта ссылка содержит активный server-side state, поэтому работает с low-security flow.
# ВНИМАНИЕ: эти ссылки одноразовые и быстро устаревают (~10 мин).
RIOT_LOGIN_URL=
